# ----------------------------------------------------------------------
# مناحل الأطلس - إعدادات Hostinger / Apache (.htaccess)
# ----------------------------------------------------------------------

# تحديد الملف الافتراضي للتشغيل (PHP أولاً ثم HTML)
DirectoryIndex index.php index.html

# ضبط ترميز الحروف للغة العربية
AddDefaultCharset UTF-8

# منع تصفح المجلدات مباشرة
Options -Indexes

# منع استعراض الملفات المخفية والتهيئة
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# تفعيل ضغط GZIP لتسريع تحميل الموقع في المغرب
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# كاش المتصفح للملفات الثابتة والصور
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# حماية إضافية للبيانات
<Files "package.json">
    Order allow,deny
    Deny from all
</Files>
<Files "tsconfig.json">
    Order allow,deny
    Deny from all
</Files>
<Files "server.ts">
    Order allow,deny
    Deny from all
</Files>
